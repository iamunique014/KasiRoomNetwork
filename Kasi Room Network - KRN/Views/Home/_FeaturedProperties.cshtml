@model IEnumerable<KasiRoomNetwork.Common.ViewModel.Home.FeaturedPropertyCardViewModel>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted mb-0">
            No rooms available at the moment.
        </p>
    </div>
}
else
{
    <div class="featured-properties-scroll">

        @foreach (var property in Model)
        {
            <div class="featured-property-card">

                <div class="card h-100 shadow-sm border-0">

                    <div class="position-relative">

                    <img src="@(string.IsNullOrWhiteSpace(property.PrimaryPhoto)
                                    ? "/images/no-image.png"
                                    : property.PrimaryPhoto)"
                        class="card-img-top"
                        style="height:150px;object-fit:cover;"
                        alt="@property.PropertyName" 
                    />

                     <span class="badge bg-success position-absolute top-0 end-0 m-2">
                        @property.AvailableRooms @(property.AvailableRooms == 1 ? "Room" : "Rooms")
                    </span>
                </div>

                    <div class="card-body d-flex flex-column p-3">

                        <h5 class="card-title mb-1">
                            @property.PropertyName
                        </h5>

                        <p class="text-muted small mb-1">
                            @property.PropertyType
                        </p>

                        <p class="text-muted small mb-2">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            @property.Suburb, @property.City
                        </p>
                       
                        <h5 class="fw-bold text-success mb-3">
                            From R @property.StartingPrice.ToString("N0") / month
                        </h5>

                        @* <a asp-controller="Property"
                           asp-action="PropertyDetails"
                           asp-route-propertyId="@property.PropertyId"
                           class="btn btn-outline-primary mt-auto">
                            View Property
                        </a> *@

                    </div>

                </div>

            </div>
        }

    </div>
}